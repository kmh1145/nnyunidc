# 数据库连接（格式：postgresql://用户名:密码@主机:端口/数据库名）
# 示例: postgresql://nnyunidc:mypass@localhost:5432/nnyunidc
# 无密码时: postgresql://nnyunidc@localhost:5432/nnyunidc
DATABASE_URL="postgresql://user:password@localhost:5432/nnyunidc"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"

# 站点地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 支付（易支付，也可在管理后台配置）
# YIPAY_API_URL="https://pay.example.com"
# YIPAY_MERCHANT_ID="1001"
# YIPAY_SECRET_KEY="your-secret-key"

# SMTP 邮件（也可在管理后台配置）
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# SMTP_FROM="noreply@nnyunidc.com"
